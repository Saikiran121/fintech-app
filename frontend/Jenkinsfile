pipeline {
    agent any

    tools {
        nodejs 'node-22'
    }

    stages {
        stage('npm version') {
            steps {
                sh 'node -v'
                sh 'npm -v'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }

        stage('Security Audit') {
            steps {
                dir('frontend') {
                    sh 'npm audit --audit-level=high || true'
                }
            }
        }

        stage('Lint') {
            steps {
                dir('frontend') {
                    sh 'npm run lint'
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('frontend') {
                    sh 'npm run test'
                }
            }
        }

        stage('Build') {
            steps {
                dir('frontend') {
                    sh 'npm run build'
                }
            }
        }

        stage('Package') {
            steps {
                dir('frontend') {
                    sh 'npm pack'
                }
            }
        }
    }

    post {
        failure {
            slackSend(
                channel: '#jenkins-notifications',   // <-- change to your Slack channel e.g. '#jenkins-alerts'
                color: 'danger',
                message: """
                    :x: *Pipeline FAILED!*
                    *Job:* ${env.JOB_NAME}
                    *Build #:* ${env.BUILD_NUMBER}
                    *Branch:* ${env.GIT_BRANCH}
                    *Details:* ${env.BUILD_URL}
                """.stripIndent()
            )
        }
        success {
            slackSend(
                channel: '#jenkins-notifications',   // <-- same channel
                color: 'good',
                message: """
                    :white_check_mark: *Pipeline PASSED!*
                    *Job:* ${env.JOB_NAME}
                    *Build #:* ${env.BUILD_NUMBER}
                    *Branch:* ${env.GIT_BRANCH}
                """.stripIndent()
            )
        }
    }
}